.feature-section {
    padding: 60px 0;
    width: 100%;
  }
  
  /* KHUNG CARD CHIA ĐÔI 50/50 */
  .feature-container-card {
    display: grid;
    grid-template-columns: 1fr 1fr; /* Chia chính xác 2 cột bằng nhau */
    width: 100%;
    background: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  }
  
  /* =========================================
     CỘT TRÁI
  ========================================= */
  .feature-left-col {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-right: 1px solid #e0e0e0;
    background: #ffffff;
    min-width: 0;
  }
  
  .feature-body {
    padding: 50px 45px 35px 45px;
    text-align: center;
  }
  
  .feature-heading {
    font-size: 26px;
    font-weight: 800;
    color: #3b1708;
    margin: 0 0 16px 0;
    letter-spacing: 0.5px;
  }
  
  .feature-summary {
    font-size: 13.5px;
    line-height: 1.6;
    color: #555555;
    margin: 0 auto 35px auto;
    max-width: 440px;
  }
  
  /* 3 DÒNG GẠCH CHÂN */
  .feature-checklist {
    max-width: 380px;
    margin: 0 auto 35px auto;
  }
  
  .check-row {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 12px 0;
    border-bottom: 1px solid #8e8e8e; /* Đường kẻ xám rõ nét */
    text-align: left;
  }
  
  .check-num {
    font-size: 15px;
    font-weight: 700;
    color: #1a1a1a;
    min-width: 24px;
  }
  
  .check-title {
    font-size: 14.5px;
    font-weight: 600;
    color: #1a1a1a;
  }
  
  /* NÚT BẤM NÂU */
  .feature-action {
    text-align: center;
  }
  
  .btn-explore {
    display: inline-block;
    padding: 12px 38px;
    background-color: #5e2c14;
    color: #ffffff;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.25s ease;
  }
  
  .btn-explore:hover {
    background-color: #3e1b0b;
    transform: translateY(-2px);
  }
  
  /* TICKER NẰM ĐÁY CỘT TRÁI */
  .feature-bottom-ticker {
    border-top: 1px solid #e0e0e0;
    padding: 16px 0;
    overflow: hidden;
    background: #ffffff;
    white-space: nowrap;
  }
  
  .ticker-inner {
    display: inline-flex;
    animation: scrollLeftFeature 20s linear infinite;
  }
  
  .ticker-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-right: 35px;
    font-size: 13px;
    font-weight: 600;
    color: #333333;
  }
  
  .ticker-item i {
    color: #5e2c14;
    font-size: 15px;
  }
  
  @keyframes scrollLeftFeature {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  
  /* =========================================
     CỘT PHẢI (ẢNH)
  ========================================= */
  .feature-right-col {
    width: 100%;
    height: 100%;
    min-height: 520px; /* Đảm bảo luôn có chiều cao cố định */
    background: #f0f0f0;
  }
  
  .feature-right-col img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  
  /* =========================================
     RESPONSIVE
  ========================================= */
  @media (max-width: 992px) {
    .feature-container-card {
      grid-template-columns: 1fr;
    }
  
    .feature-left-col {
      border-right: none;
    }
  
    .feature-right-col {
      min-height: 350px;
      height: 350px;
    }
  
    .feature-body {
      padding: 40px 20px 30px 20px;
    }
  }
