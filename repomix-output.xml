<file path="src/pages/SearchPage/SearchPage.css">
.search-page {
    background: #fcfbf9;
    min-height: 100vh;
    padding-bottom: 60px;
}

/*   ĐÃ SỬA: Đẩy padding-top lên 160px để Header không chọc thủng chữ Banner */
.search-banner {
    background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url('../../assets/img/banner_coffee.jpg') center/cover no-repeat;
    padding: 160px 0 70px;
    color: #fff;
    text-align: center;
    margin-bottom: 40px;
}

.search-banner h1 {
    font-size: 36px;
    font-weight: 800;
    margin-bottom: 15px;
}

.bread-links {
    font-size: 13px;
    letter-spacing: 1px;
    color: #ddd;
    text-transform: uppercase;
    font-weight: 600;
}

.bread-links a {
    color: #fff;
    text-decoration: none;
    transition: 0.2s;
}

.bread-links a:hover {
    color: #c99a6b;
}

.bread-links span {
    margin: 0 10px;
}

/*   ĐÃ SỬA: Bỏ cột trái, ép Container vào giữa màn hình */
.search-layout-container {
    display: block;
    max-width: 1050px;
    /* Chiều rộng vừa đủ để 3 thẻ không bị bẹp */
    margin: 0 auto;
}

/* Khối chính hiển thị kết quả */
.search-results-main {
    background: #fff;
    padding: 35px;
    border-radius: 12px;
    border: 1px solid #eae5df;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.02);
}

.search-results-topbar {
    font-size: 15px;
    color: #555;
    margin-bottom: 30px;
    padding-bottom: 15px;
    border-bottom: 1px solid #eee;
}

/*   ĐÃ SỬA: Lưới sản phẩm đúng 3 cột */
.search-products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

/* Thẻ Sản phẩm (Được nới rộng và cao hơn) */
.search-product-card {
    border: 1px solid #eae5df;
    border-radius: 12px;
    padding: 25px 20px;
    text-align: center;
    position: relative;
    cursor: pointer;
    background: #fff;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
}

.search-product-card:hover {
    box-shadow: 0 10px 30px rgba(111, 67, 35, 0.1);
    transform: translateY(-5px);
    border-color: #c99a6b;
}

.badge-discount {
    position: absolute;
    top: 15px;
    left: 15px;
    background: #fa5252;
    color: #fff;
    padding: 5px 10px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 700;
}

.card-img-wrap {
    height: 220px;
    /* Cơi nới vùng ảnh cho to rỏ */
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
}

.search-product-card img {
    max-height: 100%;
    max-width: 100%;
    object-fit: contain;
    transition: transform 0.4s ease;
}

.search-product-card:hover img {
    transform: scale(1.05);
}

.stars {
    color: #ffc107;
    font-size: 12px;
    margin-bottom: 10px;
}

.p-name {
    font-size: 17px;
    color: #333;
    font-weight: 700;
    margin-bottom: 12px;
    height: 48px;
    line-height: 1.5;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
}

.p-prices {
    margin-top: auto;
}

.old-p {
    font-size: 14px;
    color: #aaa;
    text-decoration: line-through;
    margin-right: 8px;
}

.new-p {
    font-size: 20px;
    font-weight: 800;
    color: #b23a2c;
}

.search-no-products {
    text-align: center;
    padding: 80px 20px;
    color: #666;
}

/*   CSS CHO BỘ PHÂN TRANG NẰM Ở ĐÁY */
.search-pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    margin-top: 40px;
    padding-top: 25px;
    border-top: 1px solid #eee;
}

.search-pagination .page-btn {
    width: 42px;
    height: 42px;
    border-radius: 8px;
    border: 1px solid #ddd;
    background: #fff;
    color: #555;
    cursor: pointer;
    font-weight: 700;
    font-size: 15px;
    transition: all 0.2s;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.search-pagination .page-btn:hover:not(:disabled) {
    background: #f8f9fa;
    border-color: #ccc;
    color: #333;
}

.search-pagination .page-btn.active {
    background: #6f4323;
    color: #fff;
    border-color: #6f4323;
}

.search-pagination .page-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    background: #f1f1f1;
}

/* Reponsive tự động co màn hình */
@media (max-width: 992px) {
    .search-products-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 576px) {
    .search-products-grid {
        grid-template-columns: 1fr;
    }

    .search-banner {
        padding: 130px 0 50px;
    }

    .search-banner h1 {
        font-size: 26px;
    }
}
</file>

<file path="src/pages/SearchPage/SearchPage.jsx">
import React, { useState, useEffect } from 'react';
import { useSearchParams, Link, useNavigate } from 'react-router-dom';
import { useProduct } from '../../context/ProductContext';
import './SearchPage.css';

const SearchPage = () => {
    const [searchParams] = useSearchParams();
    const query = searchParams.get('q') || '';
    const { products, formatPrice } = useProduct();
    const navigate = useNavigate();

    //   STATE CHO PHÂN TRANG (15 Sản phẩm/Trang)
    const [currentPage, setCurrentPage] = useState(1);
    const productsPerPage = 15;

    useEffect(() => {
        window.scrollTo(0, 0);
        setCurrentPage(1); // Gõ từ khóa mới thì tự động về trang 1
    }, [query]);

    // Lọc danh sách sản phẩm theo từ khóa
    const filteredProducts = products.filter(p => {
        return p.name.toLowerCase().includes(query.toLowerCase()) || 
               p.category.toLowerCase().includes(query.toLowerCase());
    });

    //   LOGIC TÍNH TOÁN PHÂN TRANG
    const indexOfLastProduct = currentPage * productsPerPage;
    const indexOfFirstProduct = indexOfLastProduct - productsPerPage;
    const currentProducts = filteredProducts.slice(indexOfFirstProduct, indexOfLastProduct);
    const totalPages = Math.ceil(filteredProducts.length / productsPerPage);

    // Hàm chuyển trang + tự cuộn lên đầu danh sách
    const paginate = (pageNumber) => {
        setCurrentPage(pageNumber);
        window.scrollTo({ top: 250, behavior: 'smooth' }); 
    };

    return (
        <div className="search-page">
            {/* BANNER ĐẦU TRANG */}
            <div className="search-banner">
                <div className="container">
                    <h1>Kết quả tìm kiếm: "{query}"</h1>
                    <div className="bread-links">
                        <Link to="/">TRANG CHỦ</Link> <span>&gt;</span> 
                        <Link to="/products">SẢN PHẨM</Link> <span>&gt;</span> 
                        <strong>KẾT QUẢ CHO "{query.toUpperCase()}"</strong>
                    </div>
                </div>
            </div>

            <div className="container search-layout-container">
                {/* CHỈ CÒN 1 CỘT DUY NHẤT Ở GIỮA */}
                <main className="search-results-main">
                    <div className="search-results-topbar">
                        <p>
                            Hiển thị {filteredProducts.length === 0 ? 0 : indexOfFirstProduct + 1}–
                            {Math.min(indexOfLastProduct, filteredProducts.length)} của {filteredProducts.length} kết quả
                        </p>
                    </div>

                    {filteredProducts.length === 0 ? (
                        <div className="search-no-products">
                            <i className="fa-solid fa-box-open" style={{fontSize: '50px', color: '#ccc', marginBottom: '15px'}}></i>
                            <h3>Không tìm thấy sản phẩm nào phù hợp!</h3>
                            <p>Thử tìm với từ khóa khác nhé Boss.</p>
                        </div>
                    ) : (
                        <>
                            {/*   LƯỚI 3 SẢN PHẨM / HÀNG */}
                            <div className="search-products-grid">
                                {currentProducts.map(product => (
                                    <div className="search-product-card" key={product.id} onClick={() => navigate(`/product/${product.id}`)}>
                                        {product.discount > 0 && <span className="badge-discount">-{product.discount}%</span>}
                                        <div className="card-img-wrap">
                                            <img src={product.imageFront || product.img} alt={product.name} />
                                        </div>
                                        <div className="card-info">
                                            <div className="stars">
                                                <i className="fa-solid fa-star"></i>
                                                <i className="fa-solid fa-star"></i>
                                                <i className="fa-solid fa-star"></i>
                                                <i className="fa-solid fa-star"></i>
                                                <i className="fa-solid fa-star"></i>
                                            </div>
                                            <h4 className="p-name">{product.name}</h4>
                                            <div className="p-prices">
                                                {product.oldPrice > 0 && <span className="old-p">{formatPrice(product.oldPrice)}</span>}
                                                <span className="new-p">{formatPrice(product.price)}</span>
                                            </div>
                                        </div>
                                    </div>
                                ))}
                            </div>

                            {/*   BỘ PHÂN TRANG (PAGINATION) */}
                            {totalPages > 1 && (
                                <div className="search-pagination">
                                    <button 
                                        className="page-btn" 
                                        disabled={currentPage === 1} 
                                        onClick={() => paginate(currentPage - 1)}
                                    >
                                        <i className="fa-solid fa-chevron-left"></i>
                                    </button>

                                    {Array.from({ length: totalPages }, (_, i) => (
                                        <button 
                                            key={i + 1} 
                                            className={`page-btn ${currentPage === i + 1 ? 'active' : ''}`}
                                            onClick={() => paginate(i + 1)}
                                        >
                                            {i + 1}
                                        </button>
                                    ))}

                                    <button 
                                        className="page-btn" 
                                        disabled={currentPage === totalPages} 
                                        onClick={() => paginate(currentPage + 1)}
                                    >
                                        <i className="fa-solid fa-chevron-right"></i>
                                    </button>
                                </div>
                            )}
                        </>
                    )}
                </main>

            </div>
        </div>
    );
};

export default SearchPage;
</file>

<file path="src/routes/AutoScrollToTop.jsx">
import { useEffect } from "react";
import { useLocation } from "react-router-dom";

const AutoScrollToTop = () => {
  // Bắt tín hiệu mỗi khi đường link (pathname) thay đổi
  const { pathname } = useLocation();

  useEffect(() => {
    // Kéo thanh cuộn lên thẳng trên cùng
    window.scrollTo({
      top: 0,
      left: 0,
      behavior: "instant", 
    });
  }, [pathname]);

  return null;
};

export default AutoScrollToTop;
</file>

<file path="src/components/AuthModal/AuthModal.css">
/* =========================================
   MỤC LỤC
   1. AUTH MODAL OVERLAY & CARD
   2. HEADER & ICON
   3. GOOGLE BUTTON & DIVIDER
   4. FORM FIELDS & INPUTS
   5. SUBMIT BUTTON & SPINNER
   6. FOOTER SWITCH
   7. ANIMATIONS
   ========================================= */

/* =========================================
   1. AUTH MODAL OVERLAY & CARD
   ========================================= */
   .auth-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(13, 13, 13, 0.78);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    padding: 20px;
    cursor: default !important;
    touch-action: none;
    animation: authFadeIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.auth-modal-card {
    position: relative;
    width: 100%;
    max-width: 440px;
    background: #ffffff;
    border-radius: 20px;
    padding: 36px 32px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35);
    cursor: default !important;
    touch-action: auto;
    animation: authSlideUp 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

.auth-modal-close {
    position: absolute;
    top: 18px;
    right: 18px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: none;
    background: #f4f1ec;
    color: #555;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer !important;
    transition: all 0.25s ease;
}

.auth-modal-close:hover {
    background: #b23a2c;
    color: #ffffff;
    transform: rotate(90deg);
}

/* =========================================
   2. HEADER & ICON
   ========================================= */
.auth-header {
    text-align: center;
    margin-bottom: 20px;
}

.auth-icon-badge {
    width: 52px;
    height: 52px;
    margin: 0 auto 12px;
    border-radius: 16px;
    background: linear-gradient(135deg, #6f4323 0%, #c99a6b 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    font-size: 20px;
    box-shadow: 0 8px 18px rgba(111, 67, 35, 0.3);
}

.auth-header h2 {
    font-size: 22px;
    font-weight: 700;
    color: #1a1a1a;
    margin-bottom: 6px;
}

.auth-subtitle {
    font-size: 13px;
    color: #777;
    margin: 0;
    line-height: 1.4;
}

/* =========================================
   3. GOOGLE BUTTON & DIVIDER
   ========================================= */
.google-auth-wrapper {
    display: flex;
    justify-content: center;
    width: 100%;
    margin-bottom: 12px;
}

.google-auth-wrapper > div {
    width: 100% !important;
    display: flex;
    justify-content: center;
}

.auth-divider {
    display: flex;
    align-items: center;
    text-align: center;
    margin: 12px 0 16px 0;
    color: #aaa;
}

.auth-divider::before,
.auth-divider::after {
    content: '';
    flex: 1;
    border-bottom: 1px solid #e5e1dc;
}

.auth-divider span {
    padding: 0 12px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: #888;
}

/* =========================================
   4. FORM FIELDS & INPUTS
   ========================================= */
.auth-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.form-group-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-align: left;
}

.form-group-field label {
    font-size: 11px;
    font-weight: 700;
    color: #555;
    text-transform: uppercase;
    letter-spacing: 0.03em;
}

.input-with-icon {
    position: relative;
    display: flex;
    align-items: center;
}

.input-with-icon i {
    position: absolute;
    left: 14px;
    color: #999;
    font-size: 14px;
}

.input-with-icon input {
    width: 100%;
    padding: 11px 14px 11px 38px;
    border: 1.5px solid #e2ded9;
    border-radius: 10px;
    font-size: 14px;
    background: #faf9f7;
    color: #222;
    outline: none;
    cursor: text !important;
    transition: all 0.25s ease;
}

.input-with-icon input:focus {
    background: #ffffff;
    border-color: #6f4323;
    box-shadow: 0 0 0 4px rgba(111, 67, 35, 0.12);
}

/* =========================================
   5. SUBMIT BUTTON & SPINNER
   ========================================= */
.auth-submit-btn {
    width: 100%;
    padding: 12px;
    margin-top: 4px;
    background: linear-gradient(135deg, #6f4323 0%, #4a2811 100%);
    color: #ffffff;
    border: none;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer !important;
    box-shadow: 0 8px 18px rgba(111, 67, 35, 0.25);
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
}

.auth-submit-btn:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 12px 24px rgba(111, 67, 35, 0.35);
}

.auth-submit-btn:disabled {
    opacity: 0.8;
    cursor: not-allowed !important;
}

.btn-loading-wrap {
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

.auth-spinner {
    width: 15px;
    height: 15px;
    border: 2px solid rgba(255, 255, 255, 0.35);
    border-top-color: #ffffff;
    border-radius: 50%;
    animation: spin 0.75s linear infinite;
}

/* =========================================
   6. FOOTER SWITCH
   ========================================= */
.auth-footer-switch {
    margin-top: 18px;
    text-align: center;
}

.auth-footer-switch p {
    font-size: 13px;
    color: #666;
    margin: 0;
}

.auth-footer-switch button {
    background: none;
    border: none;
    color: #6f4323;
    font-weight: 700;
    cursor: pointer !important;
    text-decoration: underline;
    padding: 0 4px;
}

/* =========================================
   7. ANIMATIONS
   ========================================= */
@keyframes authFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

@keyframes authSlideUp {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
}

@keyframes spin {
    to { transform: rotate(360deg); }
}
</file>

