.order-table {
    width: 100%;
    margin-bottom: 25px;
}

.order-table-header {
    display: flex;
    justify-content: space-between;
    font-weight: 700;
    color: #382212;
    padding-bottom: 15px;
    border-bottom: 2px solid #eae5df;
    font-size: 14px;
}

.order-table-body {
    padding: 15px 0;
    border-bottom: 1px solid #eae5df;
}

.order-item-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 15px;
    font-size: 14px;
    color: #555;
}

.order-item-row:last-child {
    margin-bottom: 0;
}

.item-name strong {
    color: #382212;
    margin-left: 5px;
}

.order-table-footer {
    padding-top: 15px;
}

.footer-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 15px;
    font-size: 14px;
    color: #555;
}

.footer-row strong {
    color: #382212;
}

.total-row {
    border-top: 1px solid #eae5df;
    padding-top: 15px;
    margin-bottom: 0;
    align-items: center;
}

.final-price {
    font-size: 20px !important;
    color: #b23a2c !important;
}

/* PHƯƠNG THỨC THANH TOÁN */
.payment-methods {
    margin-bottom: 20px;
    border-bottom: 1px solid #eae5df;
    padding-bottom: 20px;
}

.payment-option {
    margin-bottom: 15px;
}

.payment-option label {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    color: #382212;
    cursor: pointer;
    font-size: 14px;
}

.payment-desc {
    background: #f7f6f5;
    color: #666;
    padding: 15px;
    font-size: 13px;
    line-height: 1.6;
    border-radius: 4px;
    margin-top: 10px;
    position: relative;
}

.payment-desc::before {
    content: '';
    position: absolute;
    top: -5px;
    left: 20px;
    width: 10px;
    height: 10px;
    background: #f7f6f5;
    transform: rotate(45deg);
}

.privacy-policy-text {
    font-size: 13px;
    color: #666;
    line-height: 1.5;
    margin-bottom: 25px;
}

.btn-place-order {
    width: 100%;
    background: #6f4323;
    color: #fff;
    border: none;
    padding: 16px;
    font-size: 15px;
    font-weight: 700;
    border-radius: 4px;
    cursor: pointer;
    transition: 0.3s;
    text-transform: uppercase;
}

.btn-place-order:hover {
    background: #55331a;
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(111, 67, 35, 0.2);
}

/* RESPONSIVE */
@media (max-width: 992px) {
    .checkout-main-layout {
        grid-template-columns: 1fr;
        gap: 40px;
    }
}

@media (max-width: 576px) {
    .form-row-2 {
        grid-template-columns: 1fr;
        gap: 0;
    }
}

/* =========================================
   HIỆU ỨNG PROCESSING OVERLAY
   ========================================= */
   .order-processing-overlay {
    position: fixed;
    top: 0; 
    left: 0; 
    width: 100vw; 
    height: 100vh;
    background: rgba(255, 255, 255, 0.95);
    z-index: 999999; /* Đè lên toàn bộ website */
    display: flex;
    align-items: center;
    justify-content: center;
    animation: fadeIn 0.3s ease;
}

.processing-content {
    text-align: center;
    color: #6f4323;
}

.processing-spinner {
    font-size: 60px;
    margin-bottom: 25px;
    color: #6f4323;
}

.processing-content h2 {
    font-size: 24px;
    font-weight: 700;
    margin-bottom: 12px;
}

.processing-content p {
    color: #666;
    font-size: 15px;
}

@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}
</file>

<file path="src/pages/ContactPage/ContactPage.css">
.contact-page {
  background: #fff;
}


/* =============================
   HERO
============================= */

.contact-hero {
  min-height: 300px;

  padding-top: 85px;

  box-sizing: border-box;

  display: flex;
  align-items: center;
  justify-content: center;

  text-align: center;

  background:
    linear-gradient(
      rgba(0, 0, 0, 0.58),
      rgba(0, 0, 0, 0.7)
    ),
    url("https://cafengon.monamedia.net/wp-content/uploads/2024/12/insta3.jpg")
      center / cover no-repeat;

  color: white;
}

.contact-hero-content h1 {
  color: white;

  font-size: 42px;

  margin-bottom: 15px;

  font-weight: 700;
}

.contact-hero-content p {
  color:
    rgba(255,255,255,.85);

  margin-bottom: 20px;
}

.contact-breadcrumb {
  display: flex;

  justify-content: center;

  gap: 10px;

  font-size: 12px;
}

.contact-breadcrumb a {
  color:
    rgba(255,255,255,.65);

  text-decoration: none;
}

.contact-breadcrumb .current {
  color: #c99a6b;
}


/* =============================
   CONTENT
============================= */

.contact-section {
  padding: 65px 0;
}

.contact-layout {
  display: grid;

  grid-template-columns:
    220px 1fr;

  gap: 80px;
}


/* INFO */

.contact-info-item {
  padding:
    0 0 24px;

  margin-bottom: 24px;

  border-bottom:
    1px solid #ddd;
}

.contact-info-item:last-child {
  border-bottom: none;
}

.contact-info-item h3 {
  margin-bottom: 7px;

  font-size: 15px;

  color: #111;
}

.contact-info-item p {
  margin: 0;

  font-size: 12px;

  line-height: 1.7;

  color: #333;
}


/* FORM */

.contact-form-wrapper h2 {
  margin:
    0 0 20px;

  font-size: 25px;

  color: #111;
}

.contact-form {
  display: flex;

  flex-direction: column;

  gap: 22px;
}

.contact-form-row {
  display: grid;

  grid-template-columns:
    repeat(3, 1fr);

  gap: 22px;
}

.contact-form input,
.contact-form textarea {
  width: 100%;

  box-sizing: border-box;

  padding:
    13px 15px;

  border:
    1px solid #d7d7d7;

  outline: none;

  font-family: inherit;

  font-size: 13px;

  transition: .2s;
}

.contact-form textarea {
  resize: vertical;

  min-height: 120px;
}

.contact-form input:focus,
.contact-form textarea:focus {
  border-color: #6f4323;
}

.contact-form button {
  width: 225px;

  padding: 12px;

  border: none;

  border-radius: 3px;

  background: #7b4725;

  color: white;

  cursor: pointer;

  font-weight: 700;
}

.contact-form button:hover {
  background: #5e341d;
}

.contact-form button:disabled {
  opacity: .6;

  cursor: not-allowed;
}


/* =============================
   MAP
============================= */

.contact-map {
  width: 100%;

  height: 350px;
}

.contact-map iframe {
  width: 100%;

  height: 100%;

  border: none;
}


/* =============================
   RESPONSIVE
============================= */

@media (max-width: 900px) {

  .contact-layout {
    grid-template-columns: 1fr;

    gap: 35px;
  }

  .contact-form-row {
    grid-template-columns: 1fr;
  }

}

@media (max-width: 500px) {

  .contact-section {
    padding:
      40px 20px;
  }

  .contact-form button {
    width: 100%;
  }

}
</file>

<file path="src/pages/NewsDetailPage/NewsDetailPage.css">
/* =====================================
   NEWS DETAIL
===================================== */

.news-detail-page {
  width: 100%;
  background: #fff;
}

/* =====================================
   HERO
===================================== */

.news-detail-hero {
  position: relative;
  min-height: 430px;
  padding-top: 85px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background-position: center;
  background-repeat: no-repeat;
  background-size: cover;
  color: #fff;
}

/* =====================================
   HERO CONTENT
===================================== */

.news-detail-hero-content {
  width: 100%;
  max-width: 900px;
  padding: 70px 20px;
  text-align: center;
}

.news-detail-hero-content h1 {
  max-width: 850px;
  margin: 0 auto 22px;
  color: #fff;
  font-size: 43px;
  line-height: 1.3;
  font-weight: 700;
}

/* =====================================
   META
===================================== */

.news-detail-meta {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 25px;
  margin-bottom: 22px;
  color: rgba(255, 255, 255, 0.8);
  font-size: 13px;
}

.news-detail-meta span {
  display: flex;
  align-items: center;
  gap: 7px;
}

/* =====================================
   BREADCRUMB
===================================== */

.news-detail-breadcrumb {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
  font-size: 12px;
}

.news-detail-breadcrumb a {
  color: rgba(255, 255, 255, 0.68);
  text-decoration: none;
}

.news-detail-breadcrumb a:hover {
  color: #fff;
}

.news-detail-breadcrumb span {
  color: rgba(255, 255, 255, 0.5);
}

.news-detail-breadcrumb .current {
  color: #c99a6b;
}

/* =====================================
   SECTION
===================================== */

.news-detail-section {
  padding: 65px 20px 90px;
}

.news-detail-container {
  max-width: 950px;
  margin: 0 auto;
}

/* =====================================
   BACK BUTTON
===================================== */

.back-news {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 25px;
  color: #6f4323;
  text-decoration: none;
  font-size: 14px;
  font-weight: 600;
  transition: 0.2s;
}

.back-news:hover {
  transform: translateX(-4px);
}

/* =====================================
   ARTICLE
===================================== */

.news-detail-article {
  padding: 40px 45px;
  background: #fff;
  border-radius: 14px;
  box-shadow: 0 8px 35px rgba(0, 0, 0, 0.07);
}

/* =====================================
   EXCERPT
===================================== */

.news-detail-excerpt {
  margin: 0 0 30px;
  padding-left: 20px;
  border-left: 4px solid #6f4323;
  color: #555;
  font-size: 18px;
  line-height: 1.8;
  font-weight: 500;
}

/* =====================================
   MAIN IMAGE
===================================== */

.news-detail-main-image {
  width: 100%;
  margin-bottom: 35px;
  border-radius: 12px;
  overflow: hidden;
}

.news-detail-main-image img {
  display: block;
  width: 100%;
  max-height: 520px;
  object-fit: cover;
}

/* =====================================
   CONTENT
===================================== */

.news-detail-content {
  color: #444;
  font-size: 16px;
  line-height: 1.9;
  /* Quan trọng: xuống dòng trong Admin thì chi tiết cũng xuống dòng */
  white-space: pre-line;
  word-break: break-word;
}

/* =====================================
   FOOTER
===================================== */

.news-detail-footer {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  margin-top: 45px;
  padding-top: 20px;
  border-top: 1px solid #eee;
  color: #888;
  font-size: 13px;
}

.news-detail-footer > div {
  display: flex;
  gap: 6px;
}

.news-detail-footer strong {
  color: #6f4323;
}

/* =====================================
   LOADING / NOT FOUND
===================================== */

.news-detail-loading {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  color: #6f4323;
  font-weight: 600;
}

.news-detail-not-found {
  min-height: 80vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  padding: 30px;
}

.news-detail-not-found > i {
  margin-bottom: 20px;
  color: #6f4323;
  font-size: 60px;
}

.news-detail-not-found h1 {
  color: #382212;
  margin-bottom: 10px;
}

.news-detail-not-found p {
  color: #888;
  margin-bottom: 25px;
}

.news-detail-not-found a {
  padding: 11px 20px;
  background: #6f4323;
  color: white;
  border-radius: 7px;
  text-decoration: none;
}

/* =====================================
   TABLET
===================================== */

@media (max-width: 768px) {
  .news-detail-hero {
    min-height: 360px;
  }

  .news-detail-hero-content h1 {
    font-size: 34px;
  }

  .news-detail-article {
    padding: 30px 25px;
  }

  .news-detail-meta {
    flex-wrap: wrap;
    gap: 12px 20px;
  }
}

/* =====================================
   MOBILE
===================================== */

@media (max-width: 520px) {
  .news-detail-hero {
    min-height: 330px;
  }

  .news-detail-hero-content h1 {
    font-size: 28px;
  }

  .news-detail-section {
    padding: 40px 15px 65px;
  }

  .news-detail-article {
    padding: 25px 18px;
  }

  .news-detail-excerpt {
    font-size: 16px;
  }

  .news-detail-content {
    font-size: 15px;
  }

  .news-detail-footer {
    flex-direction: column;
  }
}

/* =====================================
   OTHER NEWS
===================================== */

.other-news-section {
  margin-top: 75px;
}

/* =====================================
   HEADING
===================================== */

.other-news-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 28px;
}

.other-news-small {
  display: block;
  margin-bottom: 7px;
  color: #c99a6b;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1.5px;
}

.other-news-heading h2 {
  margin: 0;
  color: #382212;
  font-size: 30px;
  font-weight: 700;
}

/* Xem tất cả */

.view-all-news {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: #6f4323;
  font-size: 13px;
  font-weight: 700;
  text-decoration: none;
  transition: 0.25s;
}

.view-all-news:hover {
  gap: 12px;
  color: #c99a6b;
}

/* =====================================
   GRID
===================================== */

.other-news-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24px;
}

/* =====================================
   CARD
===================================== */

.other-news-card {
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 6px 25px rgba(0, 0, 0, 0.07);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.other-news-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 12px 35px rgba(0, 0, 0, 0.11);
}

/* =====================================
   IMAGE
===================================== */

.other-news-image {
  position: relative;
  display: block;
  height: 190px;
  overflow: hidden;
}

.other-news-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.45s ease;
}

.other-news-card:hover .other-news-image img {
  transform: scale(1.07);
}

/* Nổi bật */

.other-news-featured {
  position: absolute;
  top: 12px;
  left: 12px;
  padding: 5px 9px;
  border-radius: 4px;
  background: #6f4323;
  color: #fff;
  font-size: 10px;
  font-weight: 700;
}

/* =====================================
   CONTENT
===================================== */

.other-news-content {
  padding: 18px;
}

/* Meta */

.other-news-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 10px;
  color: #999;
  font-size: 11px;
}

.other-news-meta span {
  display: flex;
  align-items: center;
  gap: 5px;
}

/* Title */

.other-news-content h3 {
  margin: 0 0 10px;
  font-size: 17px;
  line-height: 1.45;
}

.other-news-content h3 a {
  color: #382212;
  text-decoration: none;
  transition: 0.2s;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.other-news-content h3 a:hover {
  color: #c99a6b;
}

/* Excerpt */

.other-news-content p {
  margin: 0 0 15px;
  color: #777;
  font-size: 13px;
  line-height: 1.65;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Đọc thêm */

.other-news-readmore {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: #6f4323;
  font-size: 12px;
  font-weight: 700;
  text-decoration: none;
  transition: 0.25s;
}

.other-news-readmore:hover {
  gap: 10px;
  color: #c99a6b;
}

/* =====================================
   RESPONSIVE
===================================== */

@media (max-width: 850px) {
  .other-news-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 560px) {
  .other-news-heading {
    align-items: flex-start;
    flex-direction: column;
  }

  .other-news-grid {
    grid-template-columns: 1fr;
  }
}
</file>

<file path="src/pages/NewsPage/NewsPage.css">
/* =========================================
   1. BANNER TRANG TIN TỨC
========================================= */
.news-hero-banner {
  background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url('https://images.unsplash.com/photo-1497935586351-b67a49e012bf?q=80&w=2000&auto=format&fit=crop') center/cover no-repeat;
  height: 350px;
  padding-top: 25px ;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: white;
  text-align: center;
}

.news-hero-banner h1 {
  font-size: 36px;
  font-weight: 700;
  margin-bottom: 10px;
}

.news-hero-banner p {
  font-size: 15px;
  color: #e0e0e0;
  margin-bottom: 15px;
}

.news-breadcrumb {
  font-size: 13px;
  color: #bbb;
}

.news-breadcrumb a {
  color: #fff;
  text-decoration: none;
  transition: 0.2s;
}

.news-breadcrumb a:hover {
  color: #dcb193;
}

/* =========================================
 2. DANH SÁCH TIN TỨC (GRID) - GIỐNG HÌNH 1
========================================= */
.news-page-container {
  background-color: #f9f9f9; /* Nền xám nhạt để làm nổi bật thẻ trắng */
  padding: 50px 0;
}

.news-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30px;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 15px;
}

.news-card {
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 15px rgba(0,0,0,0.04);
  display: flex;
  flex-direction: column;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  text-decoration: none; /* Khử gạch chân của thẻ Link */
}

.news-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 25px rgba(0,0,0,0.08);
}

.news-card-img {
  width: 100%;
  height: 200px;
  overflow: hidden;
}

.news-card-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.news-card:hover .news-card-img img {
  transform: scale(1.05); /* Zoom nhẹ ảnh khi hover */
}

.news-card-body {
  padding: 20px 25px;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.news-card-title {
  font-size: 18px;
  font-weight: 700;
  color: #333;
  line-height: 1.4;
  margin: 0 0 12px 0;
  display: -webkit-box;
  -webkit-line-clamp: 2; /* Ép tối đa 2 dòng */
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.news-card-excerpt {
  font-size: 14px;
  color: #666;
  line-height: 1.6;
  margin: 0 0 20px 0;
  flex: 1;
  display: -webkit-box;
  -webkit-line-clamp: 3; /* Ép tối đa 3 dòng */
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.news-card-readmore {
  font-size: 13px;
  font-weight: 700;
  color: #6f4323;
  display: flex;
  align-items: center;
  gap: 5px;
  transition: 0.2s;
}

.news-card:hover .news-card-readmore {
  color: #b23a2c;
  gap: 8px; /* Mũi tên trượt nhẹ ra */
}

/* =========================================
 3. TRANG CHI TIẾT BÀI VIẾT - GIỐNG HÌNH 2
========================================= */
.news-detail-wrapper {
  background-color: #f9f9f9;
  padding: 50px 15px;
}

.news-detail-card {
  background: #fff;
  max-width: 800px;
  margin: 0 auto;
  border-radius: 16px;
  box-shadow: 0 4px 20px rgba(0,0,0,0.05);
  padding: 40px;
}

/* Nút quay lại */
.back-to-news {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: #6f4323;
  font-weight: 600;
  text-decoration: none;
  margin-bottom: 30px;
  font-size: 15px;
  transition: 0.2s;
}

.back-to-news:hover {
  color: #b23a2c;
  transform: translateX(-5px);
}

.news-detail-title {
  font-size: 28px;
  font-weight: 800;
  color: #222;
  line-height: 1.4;
  margin-bottom: 25px;
}

/* Đoạn Lead (Mở bài) kẻ viền trái đặc trưng báo chí */
.news-detail-lead {
