.site-footer {
    position: relative;
    width: 100%;
    /* Hình nền hạt cà phê tối đặc trưng */
    background: linear-gradient(rgba(10, 8, 7, 0.88), rgba(10, 8, 7, 0.94)),
                url('https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?q=80&w=1600&auto=format&fit=crop') center/cover no-repeat;
    color: #ffffff;
    padding: 55px 0 45px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  
  /* =========================================
     BỐ CỤC LƯỚI 5 CỘT (FOOTER GRID)
  ========================================= */
  .footer-grid {
    display: grid;
    grid-template-columns: 1.3fr 0.8fr 1fr 1fr 2fr;
    gap: 20px;
    align-items: flex-start;
  }
  
  /* TIÊU ĐỀ TỪNG CỘT */
  .footer-heading {
    font-size: 15px;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 18px 0;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }
  
  /* =========================================
     CỘT 1: BRAND LOGO
  ========================================= */
  .footer-logo img {
    max-width: 180px;
    height: auto;
    display: block;
    margin-bottom: 14px;
  }
  
  .footer-brand-desc {
    font-size: 13px;
    line-height: 1.65;
    color: #d1d1d1;
    margin: 0;
    max-width: 260px;
  }
  
  /* =========================================
     CÁC CỘT LIÊN KẾT (DANH MỤC, HỖ TRỢ, CHÍNH SÁCH)
  ========================================= */
  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  .footer-links li {
    margin-bottom: 10px;
  }
  
  .footer-links li a {
    color: #e0e0e0;
    font-size: 13.5px;
    text-decoration: none;
    transition: color 0.25s ease, padding-left 0.25s ease;
    display: inline-block;
  }
  
  .footer-links li a:hover {
    color: #e5a65e;
    padding-left: 4px;
  }
  
  /* =========================================
     CỘT 5: NEWSLETTER & MẠNG XÃ HỘI
  ========================================= */
  .newsletter-desc {
    font-size: 13px;
    line-height: 1.6;
    color: #d1d1d1;
    margin: 0 0 16px 0;
  }
  
  /* FORM NHẬP EMAIL */
  .newsletter-form {
    display: flex;
    align-items: stretch;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 2px;
    margin-bottom: 22px;
    overflow: hidden;
  }
  
  .newsletter-form input {
    flex: 1;
    padding: 10px 14px;
    background: transparent;
    border: none;
    outline: none;
    font-size: 13px;
    color: #ffffff;
  }
  
  .newsletter-form input::placeholder {
    color: #a8a8a8;
  }
  
  .newsletter-form button {
    background-color: #ffffff;
    color: #1a1a1a;
    border: none;
    font-size: 12.5px;
    font-weight: 700;
    padding: 0 20px;
    cursor: pointer;
    letter-spacing: 0.5px;
    transition: background-color 0.25s ease, color 0.25s ease;
  }
  
  .newsletter-form button:hover {
    background-color: #e5a65e;
    color: #ffffff;
  }
  
  /* CỤM THEO DÕI VÀ ICON */
  .footer-social-wrap {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  
  .social-label {
    font-size: 13px;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.5px;
  }
  
  .social-icons {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  
  .social-icons a {
    color: #ffffff;
    font-size: 17px;
    text-decoration: none;
    transition: color 0.25s ease, transform 0.25s ease;
  }
  
  .social-icons a:hover {
    color: #e5a65e;
    transform: translateY(-2px);
  }
  
  /* =========================================
     RESPONSIVE
  ========================================= */
  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 30px;
    }
    
    .footer-col.footer-newsletter {
      grid-column: span 2;
    }
  }
  
  @media (max-width: 576px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 25px;
    }
  
    .footer-col.footer-newsletter {
      grid-column: span 1;
    }
  }
