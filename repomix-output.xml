import React, { useState } from 'react';
import { Link } from 'react-router-dom';
import logoFox from '../../assets/img/logo_fox_coffee.png';
import './Footer.css';

const Footer = () => {
  const [email, setEmail] = useState('');

  const handleSubscribe = (e) => {
    e.preventDefault();
    if (email) {
      alert(`Đăng ký thành công với email: ${email}`);
      setEmail('');
    }
  };

  return (
    <footer className="site-footer">
      <div className="container">
        <div className="footer-grid">
          
          {/* CỘT 1: LOGO & GIỚI THIỆU */}
          <div className="footer-col footer-brand">
            <Link to="/" className="footer-logo">
              <img src={logoFox} alt="The Mona Coffee Logo" />
            </Link>
            <p className="footer-brand-desc">
              Cà phê nguyên chất được chế biến 100% nguyên chất, không pha trộn với bất kỳ loại hạt cà phê nào khác.
            </p>
          </div>

          {/* CỘT 2: DANH MỤC */}
          <div className="footer-col">
            <h4 className="footer-heading">DANH MỤC</h4>
            <ul className="footer-links">
              <li><Link to="/">Trang chủ</Link></li>
              <li><Link to="/about">Giới thiệu</Link></li>
              <li><Link to="/products">Sản phẩm</Link></li>
              <li><Link to="/news">Tin tức</Link></li>
              <li><Link to="/contact">Liên hệ</Link></li>
            </ul>
          </div>

          {/* CỘT 3: HỖ TRỢ */}
          <div className="footer-col">
            <h4 className="footer-heading">HỖ TRỢ</h4>
            <ul className="footer-links">
              <li><Link to="/faq">Câu hỏi thường gặp</Link></li>
              <li><Link to="/customer-service">Dịch vụ khách hàng</Link></li>
              <li><Link to="/stores">Vị trí cửa hàng</Link></li>
              <li><Link to="/best-sellers">Sản phẩm bán chạy</Link></li>
              <li><Link to="/manufactures">Manufactures</Link></li>
            </ul>
          </div>

          {/* CỘT 4: CHÍNH SÁCH */}
          <div className="footer-col">
            <h4 className="footer-heading">CHÍNH SÁCH</h4>
            <ul className="footer-links">
              <li><Link to="/privacy-policy">Chính sách bảo mật</Link></li>
              <li><Link to="/shipping-policy">Chính sách giao nhận</Link></li>
              <li><Link to="/return-policy">Chính sách đổi trả</Link></li>
              <li><Link to="/warranty-policy">Chính sách bảo hành</Link></li>
              <li><Link to="/terms">Điều khoản &amp; điều kiện</Link></li>
            </ul>
          </div>

          {/* CỘT 5: ĐĂNG KÝ NHẬN TIN & MẠNG XÃ HỘI */}
          <div className="footer-col footer-newsletter">
            <h4 className="footer-heading">ĐĂNG KÝ NHẬN TIN TỨC</h4>
            <p className="newsletter-desc">
              Đăng ký ngay để nhận ngay các tin tức khuyến mãi mới nhất của chúng tôi
            </p>

            <form className="newsletter-form" onSubmit={handleSubscribe}>
              <input
                type="email"
                placeholder="Nhập email..."
                value={email}
                onChange={(e) => setEmail(e.target.value)}
                required
              />
              <button type="submit">ĐĂNG KÝ</button>
            </form>

            <div className="footer-social-wrap">
              <span className="social-label">THEO DÕI</span>
              <div className="social-icons">
                <a href="https://facebook.com" target="_blank" rel="noreferrer" aria-label="Facebook">
                  <i className="fa-brands fa-facebook-f"></i>
                </a>
                <a href="https://instagram.com" target="_blank" rel="noreferrer" aria-label="Instagram">
                  <i className="fa-brands fa-instagram"></i>
                </a>
                <a href="https://youtube.com" target="_blank" rel="noreferrer" aria-label="Youtube">
                  <i className="fa-brands fa-youtube"></i>
                </a>
              </div>
            </div>
          </div>

        </div>
      </div>
    </footer>
  );
};

export default Footer;
</file>

<file path="src/components/UserProfileModal/UserProfileModal.css">
/* =========================================
   USER PROFILE MODAL OVERLAY & CARD
   ========================================= */
.profile-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(13, 13, 13, 0.78);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    padding: 20px;
    animation: profileFadeIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.profile-modal-card {
    position: relative;
    width: 100%;
    max-width: 440px;
    background: #ffffff;
    border-radius: 20px;
    padding: 36px 32px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35);
    animation: profileSlideUp 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

.profile-modal-close {
    position: absolute;
    top: 18px;
    right: 18px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: none;
    background: #f4f1ec;
    color: #555;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer !important;
    transition: all 0.25s ease;
}

.profile-modal-close:hover {
    background: #b23a2c;
    color: #ffffff;
    transform: rotate(90deg);
}

/* Header & Avatar */
/* =========================================
   HEADER, AVATAR & CAMERA UPLOAD
   ========================================= */
.profile-header {
    text-align: center;
    margin-bottom: 22px;
}

.profile-avatar-container {
    display: flex;
    justify-content: center;
    margin-bottom: 12px;
}

/* Khung tròn có chức năng click */
.avatar-clickable-wrap {
    position: relative;
    width: 76px;
    height: 76px;
    border-radius: 50%;
    cursor: pointer;
    overflow: hidden;
    box-shadow: 0 8px 18px rgba(111, 67, 35, 0.25);
    border: 3px solid #6f4323;
    transition: transform 0.2s ease;
}

.avatar-clickable-wrap:hover {
    transform: scale(1.05);
    /* Phóng to nhẹ khi rê chuột */
}

/* Hình ảnh/Chữ cái hiển thị full khung tròn */
.profile-avatar-char,
.profile-avatar-img {
    width: 100%;
    height: 100%;
    border: none;
    box-shadow: none;
    border-radius: 0;
}

.profile-avatar-char {
    background: linear-gradient(135deg, #6f4323 0%, #c99a6b 100%);
    color: #ffffff;
    font-size: 28px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
}

.profile-avatar-img {
    object-fit: cover;
}

/* Lớp phủ đen hiện icon máy ảnh */
.camera-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 35%;
    background: rgba(0, 0, 0, 0.65);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 4px;
    opacity: 0;
    transition: opacity 0.3s ease;
}

.camera-overlay i {
    color: #ffffff;
    font-size: 13px;
}

/* Hiện máy ảnh khi rê chuột vào Avatar */
.avatar-clickable-wrap:hover .camera-overlay {
    opacity: 1;
}

/* Tiêu đề */
.profile-header h2 {
    font-size: 22px;
    font-weight: 700;
    color: #1a1a1a;
    margin-bottom: 4px;
}

.profile-user-role {
    font-size: 13px;
    color: #777;
    margin: 0;
}

/* Form Styles */
.profile-form {
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.form-group-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-align: left;
}

.form-group-field label {
    font-size: 11px;
    font-weight: 700;
    color: #555;
    text-transform: uppercase;
    letter-spacing: 0.03em;
}

.input-with-icon {
    position: relative;
    display: flex;
    align-items: center;
}

.input-with-icon i {
    position: absolute;
    left: 14px;
    color: #999;
    font-size: 14px;
}

.input-with-icon input {
    width: 100%;
    padding: 11px 14px 11px 38px;
    border: 1.5px solid #e2ded9;
    border-radius: 10px;
    font-size: 14px;
    background: #faf9f7;
    color: #222;
    outline: none;
    transition: all 0.25s ease;
}

.input-with-icon input:focus {
    background: #ffffff;
    border-color: #6f4323;
    box-shadow: 0 0 0 4px rgba(111, 67, 35, 0.12);
}

.input-disabled {
    background: #ebe7e1 !important;
    color: #777 !important;
    cursor: not-allowed !important;
}

/* Submit & Logout Buttons */
.profile-save-btn {
    width: 100%;
    padding: 12px;
    margin-top: 4px;
    background: linear-gradient(135deg, #6f4323 0%, #4a2811 100%);
    color: #ffffff;
    border: none;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer !important;
    box-shadow: 0 8px 18px rgba(111, 67, 35, 0.25);
    transition: all 0.3s ease;
}

.profile-save-btn:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 12px 24px rgba(111, 67, 35, 0.35);
}

.profile-footer {
    margin-top: 16px;
    text-align: center;
}

.profile-logout-btn {
    background: #fff1f0;
    border: 1px solid #ffa39e;
    color: #a8071a;
    padding: 10px 16px;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer !important;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.2s ease;
    width: 100%;
    justify-content: center;
}

.profile-logout-btn:hover {
    background: #ffccc7;
}

@keyframes profileFadeIn {
    from {
        opacity: 0;
    }

    to {
        opacity: 1;
    }
}

@keyframes profileSlideUp {
    from {
        opacity: 0;
        transform: translateY(16px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* =========================================
   MENU CHỌN ẢNH (NẰM DƯỚI AVATAR)
========================================= */
.profile-avatar-container {
    position: relative;
    /* Đặt làm gốc để thẻ con có thể căn vị trí tuyệt đối (absolute) */
    display: inline-block;
    margin-bottom: 10px;
}

.avatar-action-menu {
    position: absolute;
    top: 100%;
    /* Đẩy menu xuống dưới cùng của thẻ ảnh */
    left: 50%;
    transform: translateX(-50%);
    /* Căn giữa menu theo ảnh */
    margin-top: 10px;
    background: #ffffff;
    border: 1px solid #eee;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    border-radius: 8px;
    padding: 8px;
    width: 170px;
    z-index: 99;
    display: flex;
    flex-direction: column;
    gap: 4px;
}

/* Thêm hình mũi tên nhỏ chỉ lên trên cho đẹp */
.avatar-action-menu::before {
    content: "";
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    border-width: 8px;
    border-style: solid;
    border-color: transparent transparent #ffffff transparent;
}

.avatar-action-menu button {
    background: transparent;
    border: none;
    text-align: left;
    padding: 10px 12px;
    font-size: 14px;
    color: #333;
    border-radius: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: inherit;
    transition: background-color 0.2s ease;
}

.avatar-action-menu button:hover {
    background-color: #f8f9fa;
}

/* Nút xóa ảnh có màu đỏ */
.avatar-action-menu button.btn-delete-avatar {
    color: #ff4d4f;
}

.avatar-action-menu button.btn-delete-avatar:hover {
    background-color: #fff1f0;
}
