}

.btn-view-receipt {
    background: #f4f1ec;
    border: 1px solid #d5c8b8;
    color: #6f4323;
    padding: 8px 16px;
    border-radius: 4px;
    font-weight: 600;
    cursor: pointer;
    transition: 0.2s;
    display: flex;
    align-items: center;
    gap: 8px;
}

.btn-view-receipt:hover {
    background: #6f4323;
    color: #fff;
}

/* ==========================================
     MODAL BIÊN LAI (RECEIPT) CHUẨN MÁY IN
========================================== */
.receipt-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    backdrop-filter: blur(3px);
}

.receipt-modal-content {
    background: transparent;
    width: 100%;
    max-width: 400px;
    position: relative;
    animation: billPopUp 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

@keyframes billPopUp {
    0% {
        transform: scale(0.8) translateY(30px);
        opacity: 0;
    }

    100% {
        transform: scale(1) translateY(0);
        opacity: 1;
    }
}

.btn-close-receipt {
    position: absolute;
    top: -40px;
    right: 0;
    background: none;
    border: none;
    color: #fff;
    font-size: 24px;
    cursor: pointer;
}

.btn-close-receipt:hover {
    color: #fa5252;
}

/* Thiết kế tờ biên lai giấy có răng cưa */
.receipt-paper {
    background: #fff;
    padding: 30px;
