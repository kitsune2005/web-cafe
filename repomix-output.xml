}

.btn-confirm.danger {
    background: #fa5252;
    color: #fff;
}

.btn-confirm.danger:hover {
    background: #f03e3e;
    transform: translateY(-2px);
}

@media (max-width: 576px) {
    .action-buttons {
        flex-direction: column;
    }
}

/* =====================================
     TRẠNG THÁI HOÀN TẤT & BÁO CÁO 
===================================== */
