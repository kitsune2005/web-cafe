}

/* THÔNG TIN THỜI GIAN */
.order-timeline p {
    margin-bottom: 5px;
    font-size: 14px;
    color: #666;
}

.order-timeline strong {
    color: #333;
}

/* BIÊN LAI (RECEIPT) */
.order-receipt {
    background: #fdfbf7;
