<file path="src/components/home/BrandsStrip/BrandsStrip.css">
.brands-strip {
    position: relative;
    width: 100%;
    padding: 32px 0;
    overflow: hidden;
    /* Màu nền kem ấm với họa tiết noise hạt giấy sang trọng */
    background-color: #f7f3ed;
    background-image: radial-gradient(rgba(107, 68, 35, 0.08) 1px, transparent 0);
    background-size: 24px 24px;
    border-top: 1px solid #eae2d6;
    border-bottom: 1px solid #eae2d6;
  }
  
  /* Hiệu ứng mờ dần hai bên viền trái/phải giúp chữ trôi ra vào tinh tế */
  .brands-wrapper {
    width: 100%;
    overflow: hidden;
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );
  }
  
  .brands-track {
    display: flex;
    width: max-content;
    /* Chạy liên tục không ngừng nghỉ */
    animation: scrollInfinite 25s linear infinite;
  }
  
  .brands-group {
    display: flex;
    align-items: center;
    gap: 75px;
    padding-right: 75px;
  }
  
  /* Kiểu chữ thương hiệu thanh lịch */
  .brand-item {
    font-family: 'Montserrat', serif, sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: #3b1708;
    letter-spacing: 0.06em;
    white-space: nowrap;
    user-select: none;
    opacity: 0.85;
    transition: opacity 0.3s ease;
  }
  
  .brand-item:hover {
    opacity: 1;
  }
  
  /* Vòng lặp chuyển động mượt mà 60fps */
  @keyframes scrollInfinite {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
</file>

<file path="src/components/home/BrandsStrip/BrandsStrip.jsx">
import React, { useState, useEffect } from 'react';
import localData from '../../../data/data.json';
import './BrandsStrip.css';

const BrandsStrip = ({ brands: propBrands }) => {
  const [brands, setBrands] = useState([]);

  useEffect(() => {
    const fallbackList = propBrands || localData.brands || [
      "La Croissanterie",
      "Belle Café",
      "THE RISTRETTO",
      "Coffeep",
      "Roses Coffee",
      "DALGONA COFFEE"
    ];
    setBrands(fallbackList);
  }, [propBrands]);

  return (
    <section className="brands-strip">
      <div className="brands-wrapper">
        {/* Nhân bản 2 nhóm liên tiếp để vòng lặp chạy liền mạch không có khoảng trắng */}
        <div className="brands-track">
          <div className="brands-group">
            {brands.map((brand, idx) => (
              <span className="brand-item" key={`b1-${idx}`}>
                {brand}
              </span>
            ))}
          </div>
          <div className="brands-group" aria-hidden="true">
            {brands.map((brand, idx) => (
              <span className="brand-item" key={`b2-${idx}`}>
                {brand}
              </span>
            ))}
          </div>
        </div>
      </div>
    </section>
  );
};

export default BrandsStrip;
</file>

<file path="src/components/home/BrewSection/BrewSection.css">
.brew-section {
    padding: 60px 0;
    background-color: #ffffff;
    width: 100%;
  }
  
  /* =========================================
     TIÊU ĐỀ
  ========================================= */
  .brew-head {
    text-align: center;
    margin-bottom: 45px;
  }
  
  .brew-title {
    font-size: 26px;
    font-weight: 800;
    color: #3b1708;
    letter-spacing: 0.5px;
    margin: 0 0 10px 0;
    text-transform: uppercase;
  }
  
  .brew-desc {
    font-size: 13.5px;
    color: #555555;
    margin: 0;
  }
  
  /* =========================================
     CAROUSEL CONTAINER & TRACK (6 CỘT)
  ========================================= */
  .brew-carousel-wrapper {
    width: 100%;
    overflow: hidden;
  }
  
  .brews-track {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    padding: 10px 0 20px 0;
    scrollbar-width: none;
  }
  
  .brews-track::-webkit-scrollbar {
    display: none;
  }
  
  /* 6 CỘT CHUẨN TRÊN CONTAINER 1200PX */
  .brew-item {
    flex: 0 0 calc((100% - 100px) / 6);
    min-width: 0;
    text-align: center;
    cursor: pointer;
    scroll-snap-align: start;
  }
  
  /* =========================================
     HIỆU ỨNG THU NHỎ KHI HOVER (SCALE DOWN)
  ========================================= */
  .brew-circle-wrap {
    width: 130px;
    height: 130px;
    margin: 0 auto 14px auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .brew-circle {
    width: 130px;
    height: 130px;
    border-radius: 50%;
    background-color: #fff6e5;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), background-color 0.35s ease;
  }
  
  .brew-circle img {
    width: 72%;
    height: 72%;
    object-fit: contain;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  
  /* Hover: Vòng tròn thu nhỏ lại và chuyển tông nền */
  .brew-item:hover .brew-circle {
    transform: scale(0.85);
    background-color: #f3dcc0;
  }
  
  .brew-item:hover .brew-circle img {
    transform: scale(0.95);
  }
  
  /* TÊN LOẠI PHA CHẾ */
  .brew-name {
    font-size: 14px;
    font-weight: 600;
    color: #2b170b;
    margin: 0;
    transition: color 0.3s ease;
  }
  
  .brew-item:hover .brew-name {
    color: #8b5e3c;
  }
  
  /* =========================================
     ĐIỀU HƯỚNG CAROUSEL
  ========================================= */
  .brew-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-top: 20px;
  }
  
  .brew-nav-btn {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid #b5b5b5;
    background: #ffffff;
    color: #333333;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.25s ease;
  }
  
  .brew-nav-btn:hover {
    background: #3b1708;
    color: #ffffff;
    border-color: #3b1708;
  }
  
  .brew-nav-btn i {
    font-size: 11px;
  }
  
  .brew-page-num {
    font-size: 13.5px;
    color: #444444;
    letter-spacing: 1px;
  }
  
  /* =========================================
     RESPONSIVE
  ========================================= */
  @media (max-width: 1024px) {
    .brew-item {
      flex: 0 0 calc((100% - 60px) / 4);
    }
  }
  
  @media (max-width: 768px) {
    .brew-item {
      flex: 0 0 calc((100% - 40px) / 3);
    }
  }
  
  @media (max-width: 480px) {
    .brew-item {
      flex: 0 0 calc((100% - 20px) / 2);
    }
  }
</file>

