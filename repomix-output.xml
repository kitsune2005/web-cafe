<file path="src/pages/AdminPage/ContactManage/ContactManage.css">
/* ==========================================
   CSS BẢNG LIÊN HỆ (Layout ngoài dùng chung)
========================================== */

/*   ĐÃ NÂNG CẤP: Bọc thép lớp vỏ ngoài cho phép cuộn ngang trên Mobile */
.contact-table-wrap {
  background: #fff;
  border-radius: 0.5rem;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch; /* Bật vuốt ngang mượt mà trên iPhone/iPad */
  padding-bottom: 0.5rem; /* Tránh thanh cuộn ăn lẹm vào nội dung */
  box-shadow: 0 0.125rem 0.625rem rgba(0,0,0,0.03); /* Tút lại tí bóng đổ cho sang */
}

/*   ĐÃ NÂNG CẤP: Ép cứng min-width không cho bảng bị bóp méo */
.contact-table {
  width: 100%;
  border-collapse: collapse;
  min-width: 55rem; /* ~880px: Khóa cứng độ rộng tối thiểu, bé hơn thì tự sinh thanh cuộn ngang */
}

.contact-table th,
.contact-table td {
  padding: 1.125rem 1rem;
  text-align: left;
  border-bottom: 1px dashed #eee;
  font-size: 0.875rem;
  vertical-align: middle;
  color: #444;
}

.contact-table th {
  color: #888;
  background: #fdfdfd;
  font-weight: 700;
  text-transform: uppercase;
  font-size: 0.75rem;
  border-bottom: 2px solid #eee;
}

.unread-row {
  background: #fffdf8;
}

.unread-row td {
  font-weight: 600; /* Làm đậm hàng chưa đọc */
}

/* INFO KHÁCH HÀNG */
.contact-customer-info {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  color: #666;
  font-size: 0.8125rem;
}

.contact-customer-info span {
  display: flex;
  gap: 0.5rem;
  align-items: center;
}

.contact-customer-info i {
  color: #a1785c;
}

.contact-message-cell {
  max-width: 15.625rem; /* ~250px */
  line-height: 1.6;
  color: #555;
}

/* BADGE TRẠNG THÁI */
.contact-status {
  display: inline-block;
  padding: 0.375rem 0.75rem;
  border-radius: 1.25rem;
  font-size: 0.6875rem;
  font-weight: bold;
  white-space: nowrap;
}

.contact-status.unread {
  background: #fff3bf;
  color: #e67700;
}

.contact-status.read {
  background: #e6fcf5;
  color: #0ca678;
}

/* HÀNG NÚT HÀNH ĐỘNG */
.contact-actions {
  display: flex;
  gap: 0.625rem;
}

/* =========================================
   ÉP GIAO DIỆN MOBILE TỰ CO GIÃN
========================================= */
@media (max-width: 64em) /* ~1024px */ {
    .product-manage-layout {
        display: flex !important;
        flex-direction: column;
    }
    
    /* Đẩy cục thống kê lên nằm ngang trên cùng khi ở màn hình nhỏ */
    .product-stats-sidebar {
        display: grid;
        grid-template-columns: 1fr 1fr;
        width: 100%;
        order: -1; 
        position: static;
        margin-bottom: 1.5rem;
    }
}

@media (max-width: 35em) /* ~560px */ {
    .product-stats-sidebar {
        grid-template-columns: 1fr; /* Rớt thành 2 hàng dọc nếu điện thoại quá nhỏ */
    }
}
