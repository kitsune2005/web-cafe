    margin-top: 5px;
}

.action-completed-area,
.action-reported-area {
    margin-top: 25px;
    border-top: 1px solid #eae5df;
    padding-top: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.success-msg {
    color: #0ca678;
    font-weight: 600;
    font-size: 14px;
